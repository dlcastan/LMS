# Copiá este archivo a .env.local y completá los valores. No commitees .env.local.

# Base de datos (Postgres)
DATABASE_URL=postgres://lms:lms@localhost:5432/lms

# Sesiones (generar el secreto con: openssl rand -base64 32)
AUTH_SECRET=

# URL pública de la app (Mercado Pago la usa para volver y para notificar).
# En local, el webhook solo llega si exponés la app con un túnel (ej. ngrok).
APP_URL=http://localhost:3000

# Mercado Pago: credenciales de prueba del panel de desarrolladores
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# true para usar el checkout sandbox
MERCADOPAGO_SANDBOX=true
# Solo para pruebas locales contra un mock; por defecto https://api.mercadopago.com
# MERCADOPAGO_API_URL=

# Bunny Stream (fuera de este plan por ahora)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
